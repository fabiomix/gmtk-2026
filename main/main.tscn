[gd_scene format=3]

[ext_resource type="Script" path="res://main/main.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/hud.tscn" id="2_hud"]
[ext_resource type="PackedScene" path="res://ui/pause_menu.tscn" id="3_pause_menu"]
[ext_resource type="PackedScene" path="res://ui/capture_screen.tscn" id="4_capture_screen"]
