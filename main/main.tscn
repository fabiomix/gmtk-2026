[ext_resource type="PackedScene" path="res://ui/journal.tscn" id="6_journal"]

[node name="Main" type="Node"]
script = ExtResource("1_script")

[node name="HUD" parent="." instance=ExtResource("2_hud")]

[node name="PauseMenu" parent="." instance=ExtResource("3_pause_menu")]

[node name="Journal" parent="." instance=ExtResource("6_journal")]

[node name="CaptureScreen" parent="." instance=ExtResource("4_capture_screen")]

[node name="EscapeScreen" parent="." instance=ExtResource("5_escape_screen")]
