[gd_scene format=3]

[ext_resource type="Script" path="res://ui/capture_screen.gd" id="1_script"]

[node name="CaptureScreen" type="CanvasLayer"]
process_mode = 3
layer = 30
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.85)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.45, 0.35, 1)
theme_override_font_sizes/font_size = 32
text = "CAUGHT"
horizontal_alignment = 1

[node name="Story" type="Label" parent="Center/Box"]
layout_mode = 2
text = "Time's up. The guards found you
and are taking you back to your cell."
horizontal_alignment = 1

[node name="HintLabel" type="Label" parent="Center/Box"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.75)
layout_mode = 2
horizontal_alignment = 1

[node name="ItemList" type="VBoxContainer" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4

[node name="ConfirmButton" type="Button" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
text = "Back to the cell"
